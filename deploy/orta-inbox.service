[Unit]
Description=OrtaInbox workspace
After=network.target

[Service]
Type=simple
User=orta-inbox
Group=orta-inbox
WorkingDirectory=/opt/orta-inbox
EnvironmentFile=/etc/orta-inbox.env
ExecStartPre=/usr/local/bin/node scripts/preflight.mjs
ExecStart=/usr/local/bin/node start.js
Restart=on-failure
RestartPreventExitStatus=78
RestartSec=3
TimeoutStopSec=10
UMask=0077
StateDirectory=orta-inbox
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
