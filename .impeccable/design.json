  "narrative": {
    "northStar": "The Shared Work Cabinet",
    "overview": "OrtaInbox extends the owner-selected QorStock and Startup Lab working cabinet. This is an ordinary Operate surface: pale blue ground, dark navy navigation, white forms, and green primary actions. The inherited shell remains the visual authority; this record does not introduce a replacement world or claim a comp-led build.\n\nIts character is direct, flat, and readable. System typography, native fields, tables, and disclosure controls make operational text the focus. Color separates navigation, actions, and supporting states; borders and spacing separate content without shadows.",
    "keyCharacteristics": [
      "Inherited navy navigation and pale blue workspace.",
      "Green primary actions and white bordered form panels.",
      "System typography with a fixed-size primary heading.",
      "Native controls, visible focus, and readable dynamic evidence."
    ],
    "rules": [
      {
        "name": "The Inherited Shell Rule",
        "body": "Extend the current QorStock and Startup Lab cabinet instead of replacing its palette, typography, or navigation grammar.",
        "section": "colors"
      },
      {
        "name": "The Fixed Heading Rule",
        "body": "Keep the primary heading at the implemented fixed 2rem size; no fluid display scale is defined.",
        "section": "typography"
      },
      {
        "name": "The Native History Rule",
        "body": "Preserve the native details/summary marker and interaction when presenting prior checks.",
        "section": "components"
      }
    ],
    "dos": [
      "Do inherit the navy header, pale workspace, white form surfaces, and green primary action.",
      "Do retain system typography and the fixed primary heading scale.",
      "Do keep native disclosure markers and visible keyboard focus.",
      "Do allow long identities and evidence to wrap with min-width: 0 and overflow-wrap: anywhere.",
      "Do retain full evidence text and previous check snapshots."
    ],
    "donts": [
      "Don't replace the inherited shell with a new visual identity.",
      "Don't imply that a branch label is an access boundary.",
      "Don't label the manual dispatch record as verified delivery.",
      "Don't remove native history markers or clip long evidence to make a layout fit."
    ]
  }
}
